# Absolute host path of the downloaded checkpoint (hf download ... --local-dir).
MODEL_DIR=/models/qwen38-flash-next
PORT=8000
# Which GPU to use (nvidia-smi index).
GPU_DEVICE=0

# Prebuilt image instead of a local build (pin the digest from the release notes):
# IMAGE=ghcr.io/dominikbucko/qwen38-flash-next-3090@sha256:<digest>

# Memory for the whole serving container. "auto" = MemTotal - HOST_RESERVE_GIB; the runtime sizes its RAM
# expert arena from this limit (limit - 10 GiB) and keeps the remaining cold experts on NVMe.
MEMORY_LIMIT=auto
HOST_RESERVE_GIB=8

# Kernel caches (Humming, Triton): the first start compiles kernels, later starts reuse them.
JIT_CACHE_DIR=./jit-cache

# Profile overrides (defaults in configs/3090-64gb-128k.env; see docs/tuning.md):
# QWEN38_HOT_ONLY=32                 # experts per layer kept on the GPU (~116 MiB of VRAM each)
# KV_CACHE_MEMORY_BYTES=3050000000   # 141,504 tokens with the INT8 KV cache
# MAX_MODEL_LEN=135168
# QWEN38_GPU_SHARE_FRAC=0.22         # share of each decode layer's cold experts the GPU computes
# QWEN38_CPU_EXPERTS_CPUS=auto       # e.g. 2-7,10-15 to pin the CPU expert pool yourself
# QWEN38_CPU_EXPERTS_STATS=64        # log decode step timings every 64 steps
# VLLM_API_KEY=                      # require this key on the OpenAI-compatible API
