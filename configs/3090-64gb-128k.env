# Default profile: one RTX 3090 (24 GB) + 64 GB system RAM, 128K context.
#
# Every value is a default: a variable already set in the environment (for example from .env) wins.
# One request at a time, up to 135,168 tokens in total (for example 131,072 prompt + 4,096 generated).
# See docs/tuning.md before changing the GPU memory settings: hot experts and the KV cache share the 24 GB.

: "${PORT:=8000}"
: "${SERVED_MODEL_NAME:=Qwen3.8-Flash-Next}"
: "${MAX_MODEL_LEN:=135168}"
: "${MAX_NUM_SEQS:=1}"
: "${MAX_NUM_BATCHED_TOKENS:=8192}"
: "${MAX_PARALLEL_LOADING_WORKERS:=1}"

# INT8 per-token-head KV cache: 141,504 tokens in 3.05 GB (1.05x one full request, which leaves room for the
# recurrent-state blocks that async prefill holds). The INT8 attention block is 3,200 tokens, so the prefix-cache
# retention interval must be a multiple of 3,200.
: "${KV_CACHE_DTYPE:=int8_per_token_head}"
: "${KV_CACHE_MEMORY_BYTES:=3050000000}"
: "${VLLM_PREFIX_CACHE_RETENTION_INTERVAL:=3200}"

# MTP speculative decoding: 3 draft tokens, so a decode step verifies 4 tokens (the CPU path handles up to 4).
: "${MTP_DEPTH:=3}"
: "${VLLM_MTP_DRAFT_VOCAB_RANGES:=[[0,65536],[248044,248320]]}"

# Experts: 32 hot experts per layer stay on the GPU; the other 480 per layer are computed by the CPU during
# decode and streamed to the GPU during prefill.
: "${QWEN38_HOT_ONLY:=32}"
# Cold experts kept in RAM: "auto" sizes the arena from the memory budget (container limit - 10 GiB); the
# rest stay on NVMe behind the page cache.
: "${QWEN38_EXPERT_ARENA_SLOTS:=auto}"
# Prefill: cold experts are copied to the GPU in groups of 80; chunks of up to 384 tokens use the CPU instead.
: "${QWEN38_STREAM_GROUP:=80}"
: "${QWEN38_CPU_PREFILL_MAX:=384}"
# Decode: up to 8 NVMe experts per step move into RAM (least recently used slot of their layer).
: "${QWEN38_EXPERT_PROMOTE:=8}"
# Decode: the GPU computes ~22% of each layer's cold experts itself, over PCIe, while the CPU does the rest.
: "${QWEN38_GPU_SHARE_FRAC:=0.22}"
# CPU placement: "auto" derives the pool and serving-process CPUs from the topology (vllm/qwen38_host.py).
: "${QWEN38_CPU_EXPERTS_CPUS:=auto}"
: "${QWEN38_MAIN_CPUS:=auto}"
# Diagnostics: log CPU/GPU decode step times every N steps (0 = off).
: "${QWEN38_CPU_EXPERTS_STATS:=0}"
: "${QWEN38_STREAM_PROFILE:=0}"

: "${QWEN38_ASYNC_SCHEDULING:=1}"
: "${QWEN38_TRITON_SKINNY:=1}"
: "${PYTORCH_CUDA_ALLOC_CONF:=expandable_segments:True}"
: "${VLLM_PLE_OFFLOAD_READY_TIMEOUT:=1200}"
: "${VLLM_QSA_EXACT_TOPK:=0}"

export PORT SERVED_MODEL_NAME MAX_MODEL_LEN MAX_NUM_SEQS MAX_NUM_BATCHED_TOKENS MAX_PARALLEL_LOADING_WORKERS
export KV_CACHE_DTYPE KV_CACHE_MEMORY_BYTES VLLM_PREFIX_CACHE_RETENTION_INTERVAL MTP_DEPTH VLLM_MTP_DRAFT_VOCAB_RANGES
export QWEN38_HOT_ONLY QWEN38_EXPERT_ARENA_SLOTS QWEN38_STREAM_GROUP QWEN38_CPU_PREFILL_MAX QWEN38_EXPERT_PROMOTE
export QWEN38_GPU_SHARE_FRAC QWEN38_CPU_EXPERTS_CPUS QWEN38_MAIN_CPUS QWEN38_CPU_EXPERTS_STATS QWEN38_STREAM_PROFILE
export QWEN38_ASYNC_SCHEDULING QWEN38_TRITON_SKINNY PYTORCH_CUDA_ALLOC_CONF VLLM_PLE_OFFLOAD_READY_TIMEOUT
export VLLM_QSA_EXACT_TOPK
